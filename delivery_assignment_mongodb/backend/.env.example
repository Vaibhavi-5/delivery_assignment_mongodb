# Copy this file to ".env" and edit.
PORT=8000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/delivery_assignment
# MongoDB Atlas (cloud) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/delivery_assignment?retryWrites=true&w=majority

# Used only by "npm test" (this database is wiped by the tests!)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/delivery_assignment_test

# Change this to a long random string before deploying
JWT_SECRET=dev-secret-change-me
